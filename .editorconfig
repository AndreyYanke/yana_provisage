root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# В Markdown два пробела на конце строки — это перенос, обрезать нельзя
trim_trailing_whitespace = false

[*.{html,css,js,ts,jsx,tsx,json,yml,yaml,svg}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab
